# Server
PORT=3000
NODE_ENV=development

# Email behavior
# Set to true to skip real sending and always return success (useful for local testing)
EMAIL_DRY_RUN=true

# SMTP configuration (choose either SMTP_URL or the individual fields)
# SMTP_URL=smtp://user:pass@smtp.example.com:587

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# Mail addresses
MAIL_TO=your_destination_email@example.com
MAIL_FROM="VideoPro Portfolio" <no-reply@example.com>